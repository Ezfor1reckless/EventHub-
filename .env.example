# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，切勿提交。
#   cp .env.example .env
# 生成密钥：openssl rand -base64 48

# ---------- 通用 ----------
COMPOSE_PROJECT_NAME=eventhub
TZ=Asia/Shanghai

# 对外域名，Nginx / Certbot / CORS 都依赖它
APP_DOMAIN=example.com
API_BASE_URL=https://api.example.com/api/v1

# Let's Encrypt 证书申请邮箱
CERTBOT_EMAIL=admin@example.com

# ---------- MySQL（业务库）----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=eventhub
MYSQL_USER=eventhub
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=eventhub
RABBITMQ_PASSWORD=change-me-rabbit

# ---------- 后端 Spring Boot（JDK 17）----------
JWT_SECRET=change-me-please-use-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------- 邮件通知 ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=change-me-smtp
SMTP_FROM=EventHub <noreply@example.com>

# ---------- 限流 / 异步 / 邮件 ----------
# 限流开关。集成测试下必须为 false，否则测试自己会被挡。
RATE_LIMIT_ENABLED=true

# 只有部署在可信反向代理（Nginx）之后才设为 true。
# 置 true 后才会采信 X-Forwarded-For —— 那个头可被客户端伪造，
# 无条件采信会让基于 IP 的限流形同虚设。
TRUST_PROXY=false

# Outbox 投递器
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISH_INTERVAL=2s
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_RETENTION=7d

# 邮件。false 时邮件只记日志不发送，开发环境无需可用 SMTP 也能跑通通知链路。
MAIL_ENABLED=false

# ---------- Matomo ----------
MATOMO_DB_HOST=matomo-db
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=change-me-matomo-db
MATOMO_DB_ROOT_PASSWORD=change-me-matomo-root
# 首次启动后在 Matomo 后台创建站点，把生成的 ID 填到这里
MATOMO_SITE_ID=1
MATOMO_URL=https://example.com/matomo

# ---------- Web / Mobile ----------
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_MATOMO_URL=https://example.com/matomo
NEXT_PUBLIC_MATOMO_SITE_ID=1

EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
EXPO_PUBLIC_MATOMO_URL=https://example.com/matomo
EXPO_PUBLIC_MATOMO_SITE_ID=1
