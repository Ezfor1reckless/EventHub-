{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(.env.example)",
      "Edit(**/.env.example)",
      "Read(.env.example)",
      "Read(**/.env.example)"
    ],
    "deny": [
      "Edit(.env)",
      "Edit(**/.env)",
      "Read(.env)",
      "Read(**/.env)"
    ]
  }
}
