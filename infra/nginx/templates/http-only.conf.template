# 首次部署用的 HTTP-only 配置。
#
# 为什么需要它：申请证书时 443 的 server 块会因为证书文件还不存在而导致
# nginx 启动失败——于是陷入死锁：要证书得先有 nginx，要 nginx 得先有证书。
# 先用这份配置把 80 端口跑起来，让 Certbot 完成 challenge，再换成 https 配置。
#
# 由 scripts/init-letsencrypt.sh 通过 envsubst 渲染后写入 conf.d/default.conf。

server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN};

    # Certbot 的 HTTP-01 验证从这里读文件
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        default_type text/plain;
        return 200 'EventHub 正在初始化，证书尚未签发。请稍后重试。';
    }
}
